<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Doc 6.1.2: the sandboxed ScreenSaver host cannot otherwise read
         ~/Library/Application Support/Steam. .saver bundles do not need
         the full app-sandbox entitlement. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array>
        <string>/Library/Application Support/Steam/</string>
        <string>/Library/Application Support/SteamLibraryScreensaver/</string>
        <string>/Library/Caches/SteamLibraryScreensaver/</string>
    </array>
</dict>
</plist>
